<?php

/**
 * @file
 * Custom module for World Tuna Day functionality.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function world_tuna_day_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'node_world_tuna_day_form' || $form_id === 'node_world_tuna_day_edit_form') {
    
    // Add our JavaScript library
    $form['#attached']['library'][] = 'world_tuna_day/conditional_fields';
    
    // Add a class to the Age Group wrapper for JavaScript targeting
    if (isset($form['field_age_group'])) {
      $form['field_age_group']['#attributes']['class'][] = 'field-age-group-wrapper';
    }
  }
}
